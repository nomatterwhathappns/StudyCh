{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:vercel",
  "functions": {
    "server.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 90,
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server.ts" },
    { "source": "/manus-storage/:path*", "destination": "/server.ts" },
    { "source": "/studych", "destination": "/server.ts" },
    { "source": "/sessions", "destination": "/server.ts" }
  ]
}
