# Copy this file to .env on your own laptop. Never commit .env or paste these values in Chat.
# Local StudyOS sends AI requests only from the local Node server to 9router on this laptop.
STUDYOS_LOCAL_MODE=true
STUDYOS_LOCAL_AI_ROUTER_URL=http://127.0.0.1:20128/v1
STUDYOS_LOCAL_AI_ROUTER_API_KEY=replace-with-the-9router-proxy-key
STUDYOS_LOCAL_AI_ROUTER_MODEL=replace-with-an-enabled-9router-model-id
